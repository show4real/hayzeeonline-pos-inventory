APP_NAME="Hayzeeonline POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Africa/Lagos, not UTC. Every timestamp in this database was written as naive
# local time under this zone — see App\Concerns\SerializesDatesForApi.
APP_TIMEZONE=Africa/Lagos
# Must match the public hostname: the 'public' disk builds image URLs from it.
APP_URL=http://localhost:8093

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# 10, not Laravel's current default of 12: existing password hashes were made
# at cost 10, and Laravel 11+ silently rehashes on login when this disagrees.
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
# Set to "stack" for a while after the upgrade to catch the next round of
# framework deprecations before they become breakages.
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# "db" is the service name on the compose network, not localhost.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=inventory_hayzeeonline_api
DB_USERNAME=root
DB_PASSWORD=password

# Renamed by Laravel 11 from BROADCAST_DRIVER / CACHE_DRIVER. The old names
# are read by nothing and fail silently, which is why they are not left here.
BROADCAST_CONNECTION=null
CACHE_STORE=file
CACHE_PREFIX=

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Renamed by Laravel 7 from MAIL_DRIVER. Nothing in the app sends mail yet.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@hayzeeonline.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Generate with: php artisan jwt:secret
JWT_SECRET=
# Minutes. 216000 = 150 days, carried over from the old config/jwt.php
# default of 60*60*60; the UI reads it back as `expire_in` on login.
JWT_TTL=216000

# Comma-separated proxy addresses, or '*'. In production Apache is the only
# thing that can reach the container, so '*' is safe there.
TRUSTED_PROXIES=*
