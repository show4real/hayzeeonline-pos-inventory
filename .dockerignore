# The build context is the repository root, which is also the Laravel app root.
# Docker only reads .dockerignore from the context root.

.git
.github
.gitignore
.gitattributes
*.md

# Never ship secrets or host state into an image.
.env
.env.*
!.env.example

# Installed fresh inside the image from composer.lock.
vendor/
node_modules/

# Cached manifests from the dev environment list dev-only providers (Pail),
# which makes package:discover fail in a --no-dev build.
bootstrap/cache/*.php

# Runtime state belongs on a volume, not in the image.
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/public/*
public/storage

# A 3.8MB production database dump that is committed to this repository. It
# has no business in an image, and it is the first thing worth deleting from
# git history — see DEPLOYMENT.md.
*.sql

# A PHP error log committed into the web root. It has no extension, so an
# extension-based nginx rule would not catch it; it is excluded here and
# denied in docker/nginx/default.conf as well.
public/error_log
public/*.log

# Typos of public/storage, both empty. The real symlink is created at runtime
# by docker/php/entrypoint.sh.
public/storages
public/storagess

# IIS front-controller leftover from a pre-Docker deployment.
public/web.config

# Laravel Mix 5 / webpack, from the Laravel 6 skeleton. The API serves one
# Blade view and builds no assets, so nothing here is used at runtime.
webpack.mix.js
package.json
package-lock.json

# Not part of the deployed application.
tests/
phpunit.xml
.phpunit.result.cache
.phpunit.cache
.styleci.yml
.editorconfig
**/.DS_Store
